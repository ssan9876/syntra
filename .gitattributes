# Scripts and files that Linux reads byte-for-byte must not pick up CRLF from
# a Windows checkout: a shebang ending in \r is "required file not found".
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.ldif text eol=lf
ops/syntra-install text eol=lf
ops/syntra-update text eol=lf
*.jpg binary
*.png binary
