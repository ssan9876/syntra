{
  "name": "syntra",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @syntra/db migrate",
    "db:generate": "pnpm --filter @syntra/db generate",
    "seed": "pnpm --filter @syntra/db seed",
    "dev": "pnpm --parallel --filter @syntra/api --filter @syntra/web dev",
    "e2e": "playwright test",
    "db:reset": "pnpm --filter @syntra/db reset"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "ldapts": "^9.0.0",
    "otpauth": "9.5.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
