# Prisma's CLI reads `.env` from its own working directory, and pnpm runs
# `prisma migrate deploy` with the cwd set to this package — so the root
# `.env` is not in scope for it and a checkout with only that file fails
# migration with "Environment variable not found: DATABASE_URL".
#
# The three below are the only ones the CLI needs. Keep them in step with the
# root `.env`: they name the same database.
DATABASE_URL=postgresql://syntra_app:syntra_app@localhost:5432/syntra

# `prisma migrate dev` builds and tears down a shadow database to diff against.
SHADOW_DATABASE_URL=postgresql://syntra_app:syntra_app@localhost:5432/syntra_shadow

# Owns the CREATE DATABASE the test harness performs for each worker's shard.
SUPERUSER_DATABASE_URL=postgresql://syntra:syntra@localhost:5432/syntra
