DATABASE_URL=postgresql://syntra_app:syntra_app@localhost:5432/syntra
PORT=3000
PUBLIC_URL=http://localhost:3000
# Both placeholders below are refused at start. Generate each with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MASTER_KEY encrypts every stored credential and signs SAML: back it up, and
# never rotate it by hand.
SESSION_SECRET=change-me-at-least-32-characters-long
MASTER_KEY=BASE64_32_BYTES_REPLACE_ME_AAAAAAAAAAAAAAAAAAA=
SMTP_URL=smtp://localhost:1025
SHADOW_DATABASE_URL=postgresql://syntra_app:syntra_app@localhost:5432/syntra_shadow

# Tests only. Simulates an attacker with direct database access, which is the
# threat the audit hash chain exists to detect. Never used by the application.
SUPERUSER_DATABASE_URL=postgresql://syntra:syntra@localhost:5432/syntra
# Authentication attempts per minute, per tenant per address.
AUTH_RATE_LIMIT_MAX=10
# And per tenant across every address at once — the ceiling that does not move
# when an attacker rents more addresses. Defaults to ten times the line above.
# AUTH_RATE_LIMIT_TENANT_MAX=100

# Tests only. The exact name of the database `pnpm db:reset` may empty. It
# refuses anything that is not a scratch `syntra_test_*` database unless this
# names the database in DATABASE_URL exactly -- typing the name out is the
# point, so nobody pastes a truthy flag into the wrong shell.
# SYNTRA_ALLOW_RESET=syntra

# Tests only. Overrides how many vitest workers/scratch databases the suite
# provisions -- defaults to cores minus one, capped at 8. Force it to 1 to
# bisect a suspected ordering dependency, or match whatever CI pins it to.
# SYNTRA_TEST_WORKERS=4

# Tests only. The transaction-budget check's ceiling in milliseconds, for a
# runner slower than the machine it was calibrated on. Defaults to 2500;
# CI sets 4500. Anything under Prisma's 5000ms interactive-transaction ceiling
# keeps the check meaningful.
# GOVERN_BUDGET_MS=2500

# The HR feed's SFTP connector refuses to resolve to a private/link-local
# address unless this is exactly `true` -- an SSRF guard that the integration
# test (which connects to a container on a private address) has to open on
# purpose. Never set outside tests.
# OUTBOUND_ALLOW_PRIVATE=true

# Tests only. The HR feed's SFTP integration test is skipped unless this is
# exactly `1`, so `pnpm test` stays hermetic. Bring the fixture up first with
# `pnpm sftp:up && pnpm sftp:wait`.
# SFTP_INTEGRATION=1
# Which port the SFTP integration test connects to, if 2222 is taken.
# SFTP_PORT=2222

# Tests only, for the Samba/Active Directory provisioning integration tests
# and the browser suite's provisioning spec. Defaults match
# `infra/docker-compose.yml`'s samba service and its DOMAINPASS -- only
# override these to point at a domain controller of your own.
# SAMBA_LDAPS_URL=ldaps://localhost:1637
# SAMBA_BASE_DN=DC=syntra,DC=test
# SAMBA_BIND_DN=CN=Administrator,CN=Users,DC=syntra,DC=test
# SAMBA_BIND_PASSWORD=Syntra!Passw0rd

# Fastify's own logger level: error, warn, info, debug, trace, silent. Unset
# defaults to info.
# LOG_LEVEL=info

# The header naming the caller's country, for the policy engine's country
# conditions -- Cloudflare sends `cf-ipcountry`; most other proxies need
# configuring by hand. Unset (the default) leaves every country condition
# unevaluable, which is right for a deployment with no proxy that sets one:
# guessing a header name would let an untrusted client claim its own country.
# POLICY_COUNTRY_HEADER=cf-ipcountry

# Which proxies may be believed about a request's source address, which feeds
# both the policy engine's IP conditions and every rate-limit key. Name them
# as addresses or CIDRs. Never `true`: that believes X-Forwarded-For from any
# client, letting anyone pick their own source address. A hop count (1) is
# refused too -- Fastify 5.12.1 made hop-count trust fail closed, so a number
# now means "trust nothing" while reading as though a proxy were configured.
# Unset trusts no proxy, which is right when there is none.
# TRUST_PROXY=10.0.0.0/8, 192.168.1.7

# WHERE THE BUILT APPLICATION LIVES, which is what turns this process from an
# API into the whole deployment: one origin, one port, no proxy in front.
#
# Unset, the API serves itself alone and `pnpm dev` puts Vite in front of it —
# right for development, and not something to put in front of real users. Set
# it after `pnpm build`, and reach the instance on PORT directly.
# WEB_ROOT=apps/web/dist

# Required by the production `docker-compose.yml` at the repository root
# (unrelated to `infra/docker-compose.yml`, the development and CI fixture
# stack) -- that compose file refuses to start without it. Not read anywhere
# else.
# SYNTRA_APP_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Updating from the console. All optional: an install that sets none of these
# has no update button, which is right for a development checkout.
#
# RELEASE_TOKEN is a fine-grained GitHub token, READ-ONLY, scoped to this one
# repository, with Contents: Read and nothing else. It can download release
# assets and do nothing else -- it is not a git credential and the host never
# gains the ability to read source history.
#
# It lives here rather than in the vault deliberately: the vault is
# tenant-scoped and this is deployment-wide, and it sits beside MASTER_KEY,
# which unseals that vault. Anyone who can read this file already holds
# strictly more than this token grants.
# ---------------------------------------------------------------------------
# RELEASE_REPO=owner/syntra
# RELEASE_TOKEN=github_pat_...
# RELEASE_ROOT=/opt/syntra
# The container PostgreSQL runs in, which is what the updater takes its
# pre-migration dump through -- there is no pg_dump on the host, and the
# version inside the container always matches the server. Not derivable from
# DATABASE_URL: `localhost:5432` says nothing about which container answers.
# Read only by `ops/syntra-update` -- nothing else in this repository looks at
# it.
# PG_CONTAINER=infra-postgres-1

# ---------------------------------------------------------------------------
# The production docker-compose.yml at the repository root, not this file's
# own deployment. Both are optional: unset, `docker compose up` pulls
# ghcr.io/ssan9876/syntra-{api,web}:latest with no TLS in front.
# ---------------------------------------------------------------------------
# Which published release to pull -- the version part of a release tag, e.g.
# `1.4.0` for tag v1.4.0, not the tag itself. Unset pulls :latest.
# SYNTRA_VERSION=1.4.0
# The public hostname, for docker-compose.tls.yml's Caddy reverse proxy --
# must resolve to this host on ports 80 and 443, so Caddy can obtain a
# Let's Encrypt certificate for it. Only read by that overlay; ignored by
# docker-compose.yml alone. Set PUBLIC_URL above to https://$SYNTRA_DOMAIN
# when this is set, or every absolute link the app builds still says http.
# SYNTRA_DOMAIN=syntra.example.com

# ---------------------------------------------------------------------------
# Metrics. Optional, and its absence is the off switch: with no token set the
# /metrics route is never registered at all, so an installation that never
# opted in answers 404 rather than a 403 that would confirm the route exists.
#
# Prometheus presents it as `Authorization: Bearer <token>`; see the
# `bearer_token` field in a scrape_config. Sixteen characters minimum, and it
# should be random -- a token short enough to guess reads as a control while
# granting a read of the installation's shape.
#
# Every series is installation-wide. There are deliberately NO per-tenant
# labels, so a scrape cannot enumerate or count tenants.
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ---------------------------------------------------------------------------
# METRICS_TOKEN=
