node_modules/
dist/
build/
.env
.env.*
!.env.example
*.log
coverage/
.turbo/
.vite/
.DS_Store
.tmp-shots/
test-results/
playwright-report/
*.tsbuildinfo
dist/
.superpowers/

# Mutation-testing output. The mutant DEFINITIONS (tools/*-mutants.json) are
# checked in — they are the mutation suite, and a reviewer needs to see what
# was mutated. The run logs and per-run results are one run's output and
# belong with the other scratch under .superpowers/.
tools/*-mutants.results.*.json

# Session tooling state — scheduler locks and the like. Nothing here describes
# the project, and a committed lock file is a merge conflict waiting for the
# next person who runs the same tool.
.claude/

# Local tooling caches, not the project.
.impeccable/
.pnpm-store/

# Secrets and machine-local files. `.env` and `.env.*` above already keep every
# environment file out (only `.env.example` templates are tracked); these cover
# the other shapes a local credential or server setting arrives in.
.envrc
.netrc
.pgpass
*.pem
*.key
*.p12
*.pfx
*.jks
*.kubeconfig
kubeconfig*
*.secret
*.secrets
secrets/
.dc-admin*
.svc-*.txt
# Local overrides of checked-in configuration.
*.local
*.local.*
docker-compose.override.yml
docker-compose.*.override.yml
values.local.yaml
# A Windows shell that does not expand %USERPROFILE% writes the literal name
# into the working directory -- which is how a password file once landed here.
*%USERPROFILE%*
