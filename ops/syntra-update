#!/usr/bin/env bash
#
# Update Syntra to a released version, and put it back if that goes wrong.
#
# NOT RUN FROM THE API PROCESS, and not runnable from one. This ends in
# `systemctl restart syntra`, so anything started as a child of the API dies
# at the exact moment the database has been migrated and the symlink has not
# yet been swapped — the least recoverable state this system has. The API
# launches it detached:
#
#   systemd-run --unit=syntra-update --collect \
#     --setenv=SYNTRA_RELEASE_TOKEN=… /opt/syntra/bin/syntra-update 1.4.0
#
# It also runs from bin/, not from a release, so that swapping `current`
# underneath it does not pull the script out from under itself.
#
#   syntra-update <version>          update to that release
#   syntra-update --adopt <version>  take a converted working tree to its first
#                                    release; by hand, once, not from the console
#   syntra-update --rollback         go back to the release we came from
#   syntra-update --check            print current and available, change nothing
#
# Every step writes to var/update.status, which is what the console reads.

set -euo pipefail

ROOT="${SYNTRA_ROOT:-/opt/syntra}"
RELEASES="$ROOT/releases"
SHARED="$ROOT/shared"
VAR="$ROOT/var"
CURRENT="$ROOT/current"
STATUS="$VAR/update.status"
LOCK="$VAR/update.lock"
# The version that was actually running before the one running now -- as
# opposed to guessed from whatever version-numbered directories happen to be
# sitting in releases/, which is what a failed update's orphaned unpack looks
# exactly like. See record_previous() and previous_release().
PREVIOUS_FILE="$VAR/previous-version"
BACKUPS="$SHARED/backups"
SERVICE="${SYNTRA_SERVICE:-syntra}"
# Resolved in resolve_environment() from shared/.env, or overridden by the
# environment the transient unit was launched with. Empty here, deliberately:
# a default assigned at the top of the file is a default nobody sees until it
# is wrong, and the one that was here judged every deployment not serving on
# port 3000 to be broken.
READY_URL="${SYNTRA_READY_URL:-}"
PG_CONTAINER="${SYNTRA_PG_CONTAINER:-}"
PG_ROLE="${SYNTRA_PG_ROLE:-}"
PG_DB="${SYNTRA_PG_DB:-}"
APP_ROLE="${SYNTRA_PG_APP_ROLE:-}"
REPO="${SYNTRA_RELEASE_REPO:-ssan9876/syntra}"
# The forge. Configurable for one reason: the rehearsal has to install
# releases that must never exist on the real repository -- a migration that
# fails, and a release whose readiness never goes green -- and a rehearsal that
# cannot stage its own failures is a rehearsal of the happy path.
RELEASE_API="${SYNTRA_RELEASE_API:-https://api.github.com}"
KEEP=3
# How long a new release gets to become ready before it is judged broken.
# Long enough for a cold start with a large migration behind it; short enough
# that nobody is signed out for a quarter of an hour while it fails.
READY_TIMEOUT=90

# --- pure helpers, lifted out by the test harness ---------------------------
# Everything above is configuration and everything below this block does I/O.
# These four are the whole of the decision-making, and they are separated so
# the tests exercise the SHIPPED logic rather than a copy of it that agrees.

# Is $1 strictly newer than $2? Uses sort -V, so 1.10.0 beats 1.9.0 — which
# a lexical comparison gets backwards, and gets backwards silently.
version_newer() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]
}

# A version string we are willing to install. Refuses anything with a slash or
# a dot-dot: this value reaches a path, and `../../etc` is a directory
# traversal wearing a version number.
version_valid() {
  case "$1" in
    *[!0-9.]*) return 1 ;;
    ''|.*|*..*|*.) return 1 ;;
    *) return 0 ;;
  esac
}

# May an update proceed from version $1, given whether --adopt was passed ($2)?
#
# `dev` is refused from the console and always will be: an install that is
# somebody's working tree has uncommitted work in it, and a tarball unpacks
# over that cleanly and silently. But a converted in-place install IS `dev` --
# syntra-install writes no RELEASE.json, because inventing a version number for
# a working tree is how an install comes to have a fictional update history --
# so a blanket refusal leaves the only deployment that exists with no route to
# a first release.
#
# --adopt is that route, and it is deliberately not reachable from the console:
# it is a one-time command run by a person who knows what is in the tree they
# are replacing, exactly like syntra-install. On a real release it is refused,
# because there it would only skip the is-this-newer check.
adoption_allowed() {
  local from="$1" adopt="${2:-}"
  if [ "$from" = "dev" ]; then
    [ "$adopt" = "1" ]
  else
    [ "$adopt" != "1" ]
  fi
}

# What WEB_ROOT should say after the install has been converted, given its
# current value ($1), the old tree ($2) and the new root ($3).
#
# WEB_ROOT is the path `registerWebApp` serves the console from AND the path
# the readiness `web` probe checks, which is why getting it wrong is so quiet:
# an absolute path into the old tree keeps serving the OLD bundle forever with
# the probe passing, because a file is indeed there. A relative one resolves
# against the process's working directory -- which systemd points at
# <release>/apps/api -- so after conversion it resolves somewhere that does not
# exist, readiness fails, and every update rolls itself back.
#
# Re-anchored at `current`, not at the release directory: the console must
# follow the symlink, or a rollback would leave the API serving the bundle of
# the release it just undid.
#
# Prints nothing and returns 1 when there is nothing to do -- unset, already
# under the new root, or somewhere outside the old tree entirely, which is a
# choice somebody made and not this script's to overrule.
rewritten_web_root() {
  local value="$1" src="$2" root="$3" rest
  [ -n "$value" ] || return 1
  src="${src%/}"
  root="${root%/}"
  value="${value%/}"

  case "$value" in
    "$root"/*) return 1 ;;
    "$src"/*)
      rest="${value#"$src"/}"
      printf '%s/current/%s\n' "$root" "$rest"
      return 0
      ;;
    /*) return 1 ;;
    *)
      # Relative: the same path, spelled from the release root instead of from
      # whatever directory the service happened to start in.
      printf '%s/current/%s\n' "$root" "$value"
      return 0
      ;;
  esac
}

# The entries in a releases directory that name a release we could actually
# run, `sort -V` ordered, newest last.
#
# `sort -V` orders the literal `dev` and any `<v>.partial` AFTER every real
# version, so both used to land in the newest-three: a rollback could target a
# half-unpacked download that had failed its checksum, a partial could evict a
# real release from the retention limit, and the conversion's copy of the
# working tree was never pruned at all.
release_candidates() {
  printf '%s\n' "$@" | grep -v '^$' | grep -Ex '[0-9]+(\.[0-9]+)*' | sort -V || true
}

# Which releases to delete, given how many to keep and the list to choose
# from. Never the one passed as $2 — deleting the release you are running is a
# way to make a rollback impossible at the moment it is needed — and never
# `dev`, which is the recovery point for a bad conversion and is not a release
# anybody is counting.
releases_to_prune() {
  local keep="$1" protect="$2"; shift 2
  local sorted
  sorted=$(release_candidates "$@")
  local total; total=$(printf '%s\n' "$sorted" | grep -c . || true)
  [ "$total" -le "$keep" ] && return 0
  printf '%s\n' "$sorted" | head -n "$(( total - keep ))" | grep -vx "$protect" || true
}

# Where a rollback goes: the newest release that is not the running one.
#
# Falls back to `dev` when there is no numeric candidate, and only then. That
# is the state immediately after an adoption — one release, plus the working
# tree it was installed over — and going back to that tree is both the correct
# answer and the only one.
previous_release_of() {
  local now="$1"; shift
  local candidate="" c
  # `release_candidates` is sorted ascending, so walking it and keeping the
  # last entry that is OLDER than $now finds the true predecessor. The old
  # version (`grep -vx "$now" | tail -1`) only excluded an EXACT match,
  # which let it return a release NEWER than $now -- the exact state left
  # behind by a failed update, where the broken release stays on disk next
  # to a working `current`. --rollback then rolled FORWARD into it.
  for c in $(release_candidates "$@"); do
    if [ "$c" != "$now" ] && version_newer "$now" "$c"; then
      candidate="$c"
    fi
  done
  if [ -n "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  if [ "$now" != "dev" ] && printf '%s\n' "$@" | grep -qx dev; then
    printf 'dev\n'
    return 0
  fi
  return 1
}

# The step name and detail, as the console will read them.
status_line() { printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2"; }

# The value of KEY in an env file, WITHOUT sourcing it.
#
# `. "$SHARED/.env"` would EXECUTE that file, and it holds MASTER_KEY and
# RELEASE_TOKEN -- values produced by base64 and by GitHub, not by anybody
# thinking about shell quoting. Sourcing it to learn a port number is a way to
# run whatever a stray backtick happens to spell, as root, from a unit nobody
# is watching.
#
# Always exits 0, including for a file that does not exist. An absent key and
# an empty key are the same answer here, and the CALLER decides what that
# means -- a missing PORT is a default, a missing DATABASE_URL is fatal.
env_value() {
  local key="$1" file="$2"
  [ -f "$file" ] || return 0
  sed -n "s/^[[:space:]]*\(export[[:space:]][[:space:]]*\)\{0,1\}${key}[[:space:]]*=[[:space:]]*\(.*\)\$/\2/p" "$file" \
    | tail -1 \
    | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}

# One field out of a PostgreSQL connection URL.
#
#   pg_url_field user postgresql://syntra_app:pw@localhost:5432/syntra -> syntra_app
#   pg_url_field db   postgresql://syntra_app:pw@localhost:5432/syntra -> syntra
#
# Refuses rather than defaults. `pg_dump -d syntra` when the URL named
# something else is a backup of the wrong database, and it looks like a
# backup right up to the moment it is restored over the right one.
pg_url_field() {
  local field="$1" url="$2" rest
  rest="${url#*://}"
  case "$field" in
    user)
      case "$rest" in
        *@*) rest="${rest%%@*}"; printf '%s\n' "${rest%%:*}"; return 0 ;;
        *)   return 1 ;;
      esac
      ;;
    db)
      case "$rest" in
        */*)
          rest="${rest#*/}"
          rest="${rest%%\?*}"
          [ -n "$rest" ] || return 1
          printf '%s\n' "$rest"
          return 0
          ;;
        *) return 1 ;;
      esac
      ;;
    *) return 2 ;;
  esac
}

# The version out of a GitHub releases-API response body, `v` prefix and all
# stripped -- the parsing half of `latest_version()` below, split out for the
# same reason `parse_asset_url()` is: it can be tested against a canned
# response with no network or token involved.
#
# Pure bash, no pipeline. What it replaced was
# `curl ... | sed -n '...p' | head -1`, which had to be read together with
# `do_check`'s `latest=$(latest_version) || latest=""` to see how a lookup
# that WORKED could still print "latest: unknown": anything that made the
# pipeline's status non-zero threw the answer away. The thing doing that was
# the RETURN trap in `auth_curl` (see there), and that is where it is fixed;
# a single expression with no pipeline and no subprocess is simply one less
# place for a status to come from that is not the answer.
parse_tag_name() {
  local body="$1"
  [[ $body =~ \"tag_name\"[[:space:]]*:[[:space:]]*\"v?([^\"]+)\" ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

# The API download URL for the asset named $2, out of a GitHub releases-API
# response body given as $1 -- the same lookup `asset_url()` below does over
# the network, split out so the parsing itself can be tested against a canned
# response with no network or token involved.
#
# Cutting v1.0.0-v1.0.3 was the first time the network-calling version ever
# ran against the real API, and it failed every time: the old implementation
# split on `,` and assumed an asset's own "url" key sat on the line
# immediately before its "name" key. GitHub's real response (pretty-printed,
# one field per line by default) puts "id" and "node_id" between them, and
# `grep -A0 -B0` inserts a `--` group separator between non-adjacent matches
# -- which then became "the line before name" instead of the actual url, so
# the lookup silently returned nothing. It only ever worked against a
# hand-built rehearsal fixture whose JSON happened to keep the two keys
# adjacent by accident.
#
# This makes no assumption about which OTHER keys sit between an asset's own
# "url" and "name", or about how the response is laid out on lines: `grep -o`
# first turns every `"key": value` pair into one output line regardless of
# the input's original formatting (works identically for GitHub's real
# multi-line response and a compact single-line one), then a small state
# machine remembers the most recent line that looked like an ASSET's own url
# (ending `/assets/<digits>`, which a nested "uploader" url never does) and
# prints it the moment the matching "name" line is reached.
parse_asset_url() {
  local body="$1" name="$2"
  printf '%s' "$body" \
    | grep -oE '"[a-zA-Z_]+"[[:space:]]*:[[:space:]]*("([^"\\]|\\.)*"|[0-9]+)' \
    | awk -v name="\"name\": \"$name\"" -v namec="\"name\":\"$name\"" '
        /^"url"[[:space:]]*:/ {
          if ($0 ~ /\/assets\/[0-9]+"/) { u = $0 }
        }
        $0 == name || $0 == namec {
          if (u != "") {
            v = u
            sub(/^"url"[[:space:]]*:[[:space:]]*"/, "", v)
            sub(/"$/, "", v)
            print v
            exit
          }
        }
      '
}

# Why a restore that produced $1 tables holding $2 rows is not a restore --
# printed, with a non-zero status. Silent and zero when it is one.
#
# Copied from `syntra-backup` rather than sourced, for the reason env_value
# is copied there: two standalone tools, and neither may fail to run because
# the other is absent.
#
# THIS IS WHAT TELLS A ROLLBACK FROM AN EMPTY DATABASE. restore_database
# drops every schema before pg_restore runs and cannot trust pg_restore's
# exit status (see there), so until this existed the only thing between
# "pg_restore failed" and the console saying "restored v1.4.0" was a
# `SELECT 1` -- which an empty database answers perfectly well, after which
# the service restarted, migrated nothing, and served a directory with nobody
# in it.
#
# ANYTHING THAT IS NOT A NUMBER IS ZERO. A psql that could not connect prints
# nothing, and nothing is not evidence of rows.
empty_restore_reason() {
  local tables="${1:-0}" rows="${2:-0}"
  case "$tables" in ''|*[!0-9]*) tables=0 ;; esac
  case "$rows"   in ''|*[!0-9]*) rows=0 ;;   esac
  if [ "$tables" -eq 0 ]; then
    printf 'no tables'
    return 1
  fi
  if [ "$rows" -eq 0 ]; then
    printf '%s table(s) and no rows at all' "$tables"
    return 1
  fi
  return 0
}

# --- everything below does I/O ----------------------------------------------

log()   { echo "[syntra-update] $*" >&2; }
status() { mkdir -p "$VAR"; status_line "$1" "${2:-}" > "$STATUS"; log "$1: ${2:-}"; }

# Records the version a successful forward update just left, so a later
# `--rollback` knows where "back" actually means. Written only here, at the
# one moment a transition is confirmed rather than merely attempted: after
# `wait_ready` has already passed for the new version. Deliberately not
# written on a rollback itself -- there is no well-defined "one before that"
# without a full history stack, so an operator who rolls back twice in a row
# lands on the same target twice rather than somewhere invented.
record_previous() { mkdir -p "$VAR"; printf '%s\n' "$1" > "$PREVIOUS_FILE"; }

die() {
  status "failed" "$1"
  log "FAILED: $1"
  exit 1
}

# Refused before anything started, so it does NOT touch update.status.
refuse() { log "REFUSED: $1"; exit 1; }

current_version() {
  if [ -f "$CURRENT/RELEASE.json" ]; then
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CURRENT/RELEASE.json" | head -1
  else
    echo dev
  fi
}

previous_release() {
  local now; now=$(current_version)

  # Trust actual history first. A directory in releases/ says a version was
  # unpacked, not that it ever ran -- Step 10 of the update rehearsal is the
  # proof: a migration that fails on purpose leaves exactly this kind of
  # orphan, sitting between the real previous version and the one it failed
  # to become, for previous_release_of()'s disk scan to walk straight into.
  if [ -s "$PREVIOUS_FILE" ]; then
    local recorded; recorded=$(head -1 "$PREVIOUS_FILE")
    if [ -n "$recorded" ] && [ "$recorded" != "$now" ] \
       && { [ "$recorded" = dev ] || [ -d "$RELEASES/$recorded" ]; }; then
      printf '%s\n' "$recorded"
      return 0
    fi
  fi

  # No history yet (nothing has ever completed an update on this install), or
  # the recorded version is no longer on disk to roll back to. Best-effort
  # guess from what is actually present, same as before this file existed.
  # shellcheck disable=SC2046
  previous_release_of "$now" $(ls -1 "$RELEASES" 2>/dev/null) || true
}

# Runs curl with the release token in a header file rather than on its
# command line. `curl -H "Authorization: Bearer $TOKEN"` puts the token in
# this process's argv, which `ps` shows to every other user on the box --
# a config file read with --config does not.
#
# The file is created with mode 600 before anything is written to it (not
# chmod'd afterward, which leaves a window where the token is readable) and
# removed via a RETURN trap, so it is gone whether curl succeeds or dies
# under `set -e`.
auth_curl() {
  local cfg status
  cfg=$(mktemp)
  chmod 600 "$cfg"
  printf 'header = "Authorization: Bearer %s"\n' "$SYNTRA_RELEASE_TOKEN" > "$cfg"
  # Removed on every path, by hand rather than by a RETURN trap. A trap set
  # inside a function is NOT scoped to it: it stays installed and fires again
  # on the next function return, where `cfg` is a dead local -- and under the
  # `set -u` at the top of this file that is a fatal "cfg: unbound variable".
  # It killed `syntra-update 1.11.1` mid-download, and before that it was what
  # made `--check` print "latest: unknown": the trap firing as latest_version
  # returned became latest_version's own exit status, so do_check discarded a
  # version it had already read. The `if` is what keeps a failing curl from
  # taking `set -e` out of the function before the file is gone.
  if curl -fsSL --config "$cfg" "$@"; then status=0; else status=$?; fi
  rm -f "$cfg"
  return "$status"
}

api() {
  [ -n "${SYNTRA_RELEASE_TOKEN:-}" ] || die "no release token was provided"
  auth_curl -H 'Accept: application/vnd.github+json' "$@"
}

latest_version() {
  parse_tag_name "$(api "$RELEASE_API/repos/$REPO/releases/latest")"
}

# The API's asset URL, not browser_download_url: a private repository serves
# assets only through the API, and the browser URL 404s with a valid token.
#
# The actual parsing is `parse_asset_url()` above, in the pure-helpers
# section -- separated so the test harness can exercise it against a canned
# response with no network or token involved.
asset_url() {
  local version="$1" name="$2"
  parse_asset_url "$(api "$RELEASE_API/repos/$REPO/releases/tags/v$version")" "$name"
}

download_asset() {
  local version="$1" name="$2" dest="$3" url
  url=$(asset_url "$version" "$name") || true
  [ -n "$url" ] || die "release v$version has no asset named $name"
  auth_curl -H 'Accept: application/octet-stream' -o "$dest" "$url"
}

ready() {
  local code
  code=$(curl -s -m 5 -o /dev/null -w '%{http_code}' "$READY_URL" || echo 000)
  [ "$code" = "200" ]
}

# Polls until ready or the deadline. Deliberately NOT /health, which is a
# constant and returns 200 for a process that cannot reach its database — as
# the gate on a rollback it would pass every broken release.
wait_ready() {
  local deadline=$(( SECONDS + READY_TIMEOUT ))
  while [ "$SECONDS" -lt "$deadline" ]; do
    ready && return 0
    sleep 3
  done
  return 1
}

dump_database() {
  local dest="$1"
  mkdir -p "$BACKUPS"
  # Created with mode 0600 before anything is written to it, not chmod'd
  # afterward. A dump is a full, unfiltered (BYPASSRLS) copy of every
  # tenant's data, and `>` alone would create it at the shell's default
  # umask -- world- or group-readable on plenty of hosts -- for however long
  # it takes pg_dump to finish writing it.
  install -m 0600 /dev/null "$dest" \
    || die "the pre-migration dump file could not be created; nothing was changed"
  # Through the container: there is no pg_dump on the host, and the version
  # inside always matches the server.
  #
  # As a role that BYPASSES RLS, which is not a detail. Every tenant-scoped
  # table here is FORCE ROW LEVEL SECURITY, and the application role is
  # deliberately NOSUPERUSER NOBYPASSRLS -- so a dump taken as the application
  # role either errors out or, with row security enabled, quietly captures the
  # rows visible to a session that has set no tenant, which is none of them.
  docker exec "$PG_CONTAINER" pg_dump -U "$PG_ROLE" -d "$PG_DB" -Fc >> "$dest" 2>/dev/null \
    || die "the pre-migration database dump failed; nothing was changed"
  # A dump that exists and is empty is worse than none, because it looks like
  # a backup. pg_dump's custom format starts with the magic "PGDMP".
  [ -s "$dest" ] || die "the pre-migration dump is empty; nothing was changed"
  head -c 5 "$dest" | grep -q PGDMP \
    || die "the pre-migration dump is not a PostgreSQL archive; nothing was changed"
  # AND IT CONTAINS ROWS. The two checks above pass on a structurally perfect
  # archive of nothing, which is exactly what an RLS-filtered dump is. This is
  # the check that can tell a backup from something shaped like one.
  local sections
  sections=$(docker exec -i "$PG_CONTAINER" pg_restore -l < "$dest" 2>/dev/null \
    | grep -c 'TABLE DATA' || true)
  [ "${sections:-0}" -gt 0 ] \
    || die "the pre-migration dump contains no table data, so it is not a backup; nothing was changed"
  log "dumped $(wc -c < "$dest") bytes, $sections table(s) of data, to $dest"
}

restore_database() {
  local src="$1"
  [ -s "$src" ] || { log "no dump to restore from"; return 1; }

  # THE SCHEMAS GO FIRST, and this is the whole of the fix.
  #
  # `pg_restore --clean --if-exists` drops only what is IN THE ARCHIVE. Every
  # table, type, index and policy the new release's migration created is
  # absent from a dump taken BEFORE that migration -- so all of it survives a
  # rollback, while the restored _prisma_migrations no longer has a row saying
  # it was ever applied. The next attempt then dies at `migrating` with
  # `relation "X" already exists` and repeats forever, while the console says
  # "Nothing was left half-applied."
  #
  # Every non-system schema, not just `public`: pg-boss creates and migrates
  # its own, and a release that moved its queue tables would leave them behind
  # the same way.
  #
  # Afterwards the database holds exactly what the dump holds, which is what
  # the word restore means.
  docker exec -i "$PG_CONTAINER" psql -v ON_ERROR_STOP=1 -U "$PG_ROLE" -d "$PG_DB" >/dev/null 2>&1 <<SQL
DO \$\$
DECLARE s text;
BEGIN
  FOR s IN
    SELECT nspname FROM pg_namespace
     WHERE nspname NOT LIKE 'pg\\_%' AND nspname <> 'information_schema'
  LOOP
    EXECUTE format('DROP SCHEMA IF EXISTS %I CASCADE', s);
  END LOOP;
END \$\$;
CREATE SCHEMA public;
-- Mirrors infra/initdb/01-app-role.sql. The application role OWNS the schema
-- and its tables, which is what makes FORCE ROW LEVEL SECURITY bind the owner
-- -- so restoring into a schema owned by the dumping superuser would leave a
-- database whose isolation model is subtly not the one that was tested.
ALTER SCHEMA public OWNER TO "$APP_ROLE";
GRANT ALL ON SCHEMA public TO "$APP_ROLE";
SQL
  if [ "$?" -ne 0 ]; then
    log "the schemas could not be dropped before restoring; NOT restoring over a database in an unknown state"
    return 1
  fi

  # pg_restore exits non-zero on benign "does not exist" noise from --clean,
  # so its status is not the test. What arrived is, below.
  docker exec -i "$PG_CONTAINER" pg_restore -U "$PG_ROLE" -d "$PG_DB" --clean --if-exists \
    < "$src" >/dev/null 2>&1 || true

  if ! docker exec "$PG_CONTAINER" psql -U "$PG_ROLE" -d "$PG_DB" -c 'SELECT 1' >/dev/null 2>&1; then
    log "the database is not answering after the restore"
    return 1
  fi

  # AND IT HOLDS ROWS. The schemas were dropped above, so a pg_restore that
  # failed has left an EMPTY database that answers SELECT 1 -- and returning
  # zero here would restart the service over it and report the rollback a
  # success. Non-zero instead, so the caller says RESTORE IT BY HAND and the
  # dump stays on disk for that.
  local counts reason
  counts=$(restored_counts "$PG_DB")
  if ! reason=$(empty_restore_reason "${counts%% *}" "${counts##* }"); then
    log "the rollback did NOT restore data: $PG_DB holds $reason after restoring $src"
    return 1
  fi
  log "restored $src -- ${counts%% *} tables, ~${counts##* } rows"
}

# What a restore into database $1 actually produced, as "<tables> <rows>".
# The same query `syntra-backup verify` runs against its scratch database.
#
# ANALYZE first: pg_stat_user_tables is an estimate, and statistics that were
# never gathered read as zero rows in a database that is full of them.
restored_counts() {
  local db="$1" tables rows
  docker exec "$PG_CONTAINER" psql -U "$PG_ROLE" -d "$db" -c 'ANALYZE' >/dev/null 2>&1 || true
  tables=$(docker exec "$PG_CONTAINER" psql -U "$PG_ROLE" -d "$db" -tAc \
    "SELECT count(*) FROM pg_stat_user_tables" 2>/dev/null | tr -d ' \r')
  rows=$(docker exec "$PG_CONTAINER" psql -U "$PG_ROLE" -d "$db" -tAc \
    "SELECT COALESCE(SUM(n_live_tup), 0) FROM pg_stat_user_tables" 2>/dev/null | tr -d ' \r')
  # `0` rather than empty, so the caller always gets two words back.
  printf '%s %s' "${tables:-0}" "${rows:-0}"
}

# The symlink alone -- no restart. Shared by the normal switch and by the
# rollback paths, which need the swap to happen while the service is
# STOPPED, not running.
link_current() {
  ln -sfn "$RELEASES/$1" "$CURRENT"
}

swap_to() {
  link_current "$1"
  # Guarded: `systemctl restart` failing here must not abort the script
  # under `set -e` with nothing written. The very next thing that runs after
  # this (status "checking"; wait_ready) already exists to detect exactly
  # this -- a service that did not come up -- and route it into
  # restore_after_failure. A failed restart just makes wait_ready fail
  # immediately instead of after the timeout, and the existing machinery
  # takes it from there.
  systemctl restart "$SERVICE" || true
}

# Stops the service before the database changes under it. Best-effort: a
# unit that is not running, or does not exist for some reason, must not stop
# a rollback that is the last line of defense this system has.
stop_service() {
  systemctl stop "$SERVICE" 2>/dev/null || true
}

# What this deployment's database actually is, read from the configuration the
# SERVICE is started with rather than assumed.
#
# `resolve_environment` is called from main(), after the lock and never at
# source time: the test harness sources this file to reach the pure helpers
# above, and a script that read files on import would make the tests depend on
# a machine that has been installed.
DB_URL=""
SHADOW_URL=""

resolve_environment() {
  DB_URL="${SYNTRA_DATABASE_URL:-$(env_value DATABASE_URL "$SHARED/.env")}"
  [ -n "$DB_URL" ] \
    || die "no DATABASE_URL in $SHARED/.env, so the migration step has nothing to connect to"

  # Named in the datasource block, so the schema does not LOAD without it --
  # even though `migrate deploy` never connects to it and only `migrate dev`
  # does. Falling back to the real URL is therefore correct rather than a
  # compromise: nothing will open it.
  SHADOW_URL="${SYNTRA_SHADOW_DATABASE_URL:-$(env_value SHADOW_DATABASE_URL "$SHARED/.env")}"
  [ -n "$SHADOW_URL" ] || SHADOW_URL="$DB_URL"

  # THE PORT THIS DEPLOYMENT ACTUALLY SERVES ON.
  #
  # PORT is a validated configuration key, and the fixed 127.0.0.1:3000 that
  # was here meant a deployment that set it had its healthy new release judged
  # broken at the verify step and rolled back -- and then the ROLLBACK's own
  # readiness check failed identically, so a system that was never broken ended
  # at `failed`. Read here rather than defaulted, because a default is a value
  # nobody looks at until it is wrong.
  if [ -z "$READY_URL" ]; then
    local port; port=$(env_value PORT "$SHARED/.env")
    READY_URL="http://127.0.0.1:${port:-3000}/health/ready"
  fi

  # WHICH DATABASE, AND AS WHOM.
  #
  # The database name comes from the connection string the service uses, so a
  # dump and a restore cannot land on a database nobody named.
  #
  # The ROLE deliberately does not: the application role is NOSUPERUSER
  # NOBYPASSRLS by design, and every tenant-scoped table is FORCE ROW LEVEL
  # SECURITY -- so a pg_dump as that role captures the rows visible to a
  # session with no tenant set, which is none of them. The dump has to be
  # taken by a role that bypasses RLS, which is SUPERUSER_DATABASE_URL's role
  # where one is configured.
  [ -n "$PG_DB" ]    || PG_DB=$(pg_url_field db "$DB_URL") \
    || die "DATABASE_URL names no database, so there is nothing to dump or migrate"
  [ -n "$APP_ROLE" ] || APP_ROLE=$(pg_url_field user "$DB_URL") \
    || die "DATABASE_URL names no role, so the restored schema would have no owner"
  if [ -z "$PG_ROLE" ]; then
    local super; super=$(env_value SUPERUSER_DATABASE_URL "$SHARED/.env")
    if [ -n "$super" ]; then
      PG_ROLE=$(pg_url_field user "$super") || PG_ROLE=""
    fi
    # Falls back to the database's own name, which is the convention this
    # deployment's infra follows: the owning role and the database share it.
    [ -n "$PG_ROLE" ] || PG_ROLE="$PG_DB"
  fi

  # The container the database runs in. Not derivable from a connection string
  # -- `localhost:5432` says nothing about which container answers it -- so it
  # is configuration, with the lab's compose project name as the default.
  [ -n "$PG_CONTAINER" ] || PG_CONTAINER=$(env_value PG_CONTAINER "$SHARED/.env")
  [ -n "$PG_CONTAINER" ] || PG_CONTAINER="infra-postgres-1"

  log "database $PG_DB in $PG_CONTAINER as $PG_ROLE; readiness at $READY_URL"
}

# --- the update -------------------------------------------------------------

do_update() {
  local target="$1"
  local adopt="${2:-}"
  local from; from=$(current_version)

  version_valid "$target" || die "\"$target\" is not a version this will install"

  adoption_allowed "$from" "$adopt" \
    || if [ "$from" = "dev" ]; then
         die "this install is a working tree, not a release; take it to its first release once with: syntra-update --adopt <version>"
       else
         die "--adopt is for a working tree taking its first release; this install is already v$from"
       fi

  # Skipped for an adoption and only for one: `dev` cannot be ordered against
  # a number -- that is what makes the comparison safe to trust everywhere
  # else -- so there is nothing here to compare and the operator naming the
  # version IS the decision.
  if [ "$from" != "dev" ]; then
    version_newer "$target" "$from" || die "$target is not newer than the running $from"
  fi

  local dir="$RELEASES/$target"
  local tmp="$dir.partial"
  local tarball="$VAR/syntra-$target.tar.gz"

  status "downloading" "fetching v$target"
  mkdir -p "$RELEASES" "$VAR"
  rm -rf "$tmp" "$tarball" "$tarball.sha256"
  download_asset "$target" "syntra-$target.tar.gz" "$tarball"
  download_asset "$target" "syntra-$target.tar.gz.sha256" "$tarball.sha256"

  status "verifying" "checking the download"
  ( cd "$VAR" && sha256sum -c "$(basename "$tarball").sha256" >/dev/null ) \
    || die "the downloaded release does not match its checksum"

  status "unpacking" "unpacking v$target"
  # Into .partial and renamed, so an interrupted download never leaves a
  # half-tree that the next run mistakes for an installed release.
  mkdir -p "$tmp"
  tar -xzf "$tarball" -C "$tmp" --strip-components=1
  [ -f "$tmp/RELEASE.json" ] || die "the release is missing RELEASE.json"
  [ -f "$tmp/apps/web/dist/index.html" ] || die "the release carries no built console"
  rm -rf "$dir" && mv "$tmp" "$dir"

  # Configuration is shared, never copied: an update must not touch .env, and
  # a rollback must not revert it.
  ln -sfn "$SHARED/.env" "$dir/.env"

  status "installing" "installing dependencies"
  ( cd "$dir" && pnpm install --frozen-lockfile --prod=false ) \
    || die "dependencies could not be installed for v$target"

  status "generating" "generating the database client"
  # U2. `node_modules` is deliberately not in the tarball, and @prisma/client's
  # postinstall cannot find packages/db/prisma/schema.prisma from the release
  # root -- so `pnpm install` alone leaves a release whose every query throws
  # "@prisma/client did not initialize yet". The API starts fine, `/health`
  # answers 200 throughout, readiness stays 503 for the full 90 seconds, and
  # the rollback then discards anything written in between.
  #
  # Before the dump, deliberately: this is the last step that can fail with
  # nothing to undo.
  ( cd "$dir" && env DATABASE_URL="$DB_URL" SHADOW_DATABASE_URL="$SHADOW_URL" \
      pnpm --filter @syntra/db exec prisma generate ) \
    || die "the database client could not be generated for v$target"

  local dump="$BACKUPS/pre-$target-$(date -u +%Y%m%dT%H%M%SZ).dump"
  status "backing-up" "dumping the database"
  dump_database "$dump"

  status "migrating" "applying migrations"
  # In the NEW release: the migrations being applied are its own.
  #
  # DATABASE_URL is passed IN, and that is the whole of U1. The Prisma CLI
  # reads `.env` from ITS OWN working directory -- `packages/db`, under
  # `pnpm --filter` -- and `packages/db/.env` is gitignored, so it is not in
  # the tarball and never will be. The root `.env` symlinked into the release
  # is not in scope for it. Every console update reached this line and failed
  # with "Environment variable not found: DATABASE_URL", and every one of them
  # rolled back.
  ( cd "$dir" && env DATABASE_URL="$DB_URL" SHADOW_DATABASE_URL="$SHADOW_URL" \
      pnpm --filter @syntra/db exec prisma migrate deploy ) \
    || { restore_after_failure "$from" "$dump" "migrations failed"; }

  status "switching" "restarting on v$target"
  swap_to "$target"

  # NOT `verifying`, which is the checksum. This is a different question asked
  # at a different time -- "does the release that is now running actually
  # work?" -- and reusing the label meant the console told an operator their
  # download was being checked while their service was down.
  status "checking" "waiting for v$target to become ready"
  if ! wait_ready; then
    restore_after_failure "$from" "$dump" "v$target did not become ready within ${READY_TIMEOUT}s"
  fi

  status "pruning" "removing old releases"
  prune "$target"

  # The new release's updater becomes the one the NEXT update runs, and only
  # after this one has been proved good. Copied last, deliberately: an updater
  # replaced before the verification would be the new one rolling back on
  # behalf of a release that never worked.
  install -m 0755 "$dir/ops/syntra-update" "$ROOT/bin/syntra-update" 2>/dev/null || true

  record_previous "$from"
  status "succeeded" "now running v$target"
  log "updated $from -> $target"
}

# The whole reason this design exists. Nobody is asked; nobody could be asked,
# because the console they would be asked through is the thing that is down.
restore_after_failure() {
  local back_to="$1" dump="$2" why="$3"
  log "ROLLING BACK: $why"
  status "rolling-back" "$why"

  # STOPPED before the schema drop, not restarted after it. restore_database
  # now drops and recreates every non-system schema; a live app (and
  # pg-boss, which owns a schema of its own) fighting that DROP is how the
  # drop hangs on a lock, or the restore races a schema pg-boss just
  # recreated.
  stop_service
  link_current "$back_to"
  # restore_database is non-zero when the restore FAILED, and also when it
  # "succeeded" into an empty database -- see there. Either way the service
  # is not restarted over it: a database with nothing in it is not one to
  # migrate and serve, and the dump is still on disk.
  if restore_database "$dump"; then
    systemctl restart "$SERVICE" || true
  else
    log "the database could not be restored from $dump — RESTORE IT BY HAND"
    status "failed" "$why; the database could not be restored automatically (dump: $dump)"
    exit 1
  fi

  if wait_ready; then
    status "rolled_back" "$why; restored v$back_to"
    exit 1
  fi
  status "failed" "$why; the rollback to v$back_to is also not ready"
  exit 1
}

do_rollback() {
  local from; from=$(current_version)
  local back_to; back_to=$(previous_release)
  [ -n "$back_to" ] || die "there is no previous release to go back to"

  local dump
  dump=$(ls -1t "$BACKUPS"/pre-"$from"-*.dump 2>/dev/null | head -1 || true)
  [ -n "$dump" ] || die "no database dump was taken before v$from; roll back by hand"

  status "rolling-back" "returning to v$back_to"
  stop_service
  link_current "$back_to"
  restore_database "$dump" || die "the database could not be restored from $dump"
  systemctl restart "$SERVICE" || true
  wait_ready || die "v$back_to did not become ready"
  status "rolled_back" "returned to v$back_to"
}

prune() {
  local protect="$1"
  local doomed
  # shellcheck disable=SC2046
  doomed=$(releases_to_prune "$KEEP" "$protect" $(ls -1 "$RELEASES" 2>/dev/null))
  for name in $doomed; do
    log "pruning release $name"
    rm -rf "${RELEASES:?}/$name"
  done
  # Partial directories are no longer counted as releases, which also means
  # nothing was ever removing them. An interrupted download leaves one behind,
  # and the next attempt at the same version starts with `rm -rf "$tmp"` -- but
  # an attempt at a DIFFERENT version never touches it.
  for partial in "$RELEASES"/*.partial; do
    [ -d "$partial" ] || continue
    log "removing abandoned $(basename "$partial")"
    rm -rf "$partial"
  done
  ls -1t "$BACKUPS"/*.dump 2>/dev/null | tail -n +$(( KEEP + 1 )) | while read -r old; do
    log "pruning dump $(basename "$old")"
    rm -f "$old"
  done
}

do_check() {
  local from latest
  from=$(current_version)
  # Tolerant of everything --check can fail at: no token (this command is
  # documented to run without one), the forge being unreachable, whatever.
  # --check promises to "change nothing", and that includes update.status --
  # api()'s die on a missing token used to write `failed` over a DIFFERENT,
  # running update's status just because somebody ran --check beside it,
  # which is exactly the hazard refuse() exists to prevent everywhere else
  # in this file. Checked here rather than by changing api()/die themselves,
  # which are correct as they are for a real update already in progress.
  if [ -z "${SYNTRA_RELEASE_TOKEN:-}" ]; then
    latest=""
  else
    latest=$(latest_version 2>/dev/null) || latest=""
  fi
  echo "current: $from"
  echo "latest:  ${latest:-unknown}"
  if [ "$from" = "dev" ]; then
    echo "state:   working tree -- not updatable from the console; take its first release with: syntra-update --adopt <version>"
  elif [ -n "$latest" ] && version_newer "$latest" "$from"; then
    echo "state:   an update is available"
  else
    echo "state:   up to date"
  fi
}

main() {
  local adopt=""
  case "${1:-}" in
    --check)    do_check; return ;;
    --rollback) : ;;
    --adopt)
      adopt=1
      shift
      [ -n "${1:-}" ] || refuse "usage: syntra-update --adopt <version>"
      ;;
    '')         refuse "usage: syntra-update <version> | --adopt <version> | --rollback | --check" ;;
  esac

  mkdir -p "$VAR"
  # One at a time. Two updaters sharing a symlink and a database is a way to
  # end up running neither version.
  exec 9>"$LOCK"
  flock -n 9 || refuse "another update is already running"

  resolve_environment

  if [ "$1" = "--rollback" ]; then do_rollback; else do_update "$1" "$adopt"; fi
}

# Sourced by the tests to get at the pure helpers without running anything.
if [ "${SYNTRA_UPDATE_SOURCE_ONLY:-}" != "1" ]; then
  main "$@"
fi
