[Unit]
Description=Syntra database backup
# The database is in the container stack. A backup that runs before Postgres
# is up fails, retries nothing, and leaves a timer that has "succeeded" at
# doing nothing every night since the last reboot.
After=docker.service
Requires=docker.service
# A failed backup must not be silent. Type=oneshot with no OnFailure= exits
# non-zero into a journal nobody reads, while the timer stays "active
# (waiting)" and `list-timers` still shows a healthy next elapse -- so the
# schedule goes on looking exactly like one that is working, which is the
# failure docs/operate.md argues against for verify and had here as well.
# See syntra-backup-failed@.service; %n is this unit, so the report names it.
OnFailure=syntra-backup-failed@%n.service

[Service]
Type=oneshot
ExecStart=/opt/syntra/bin/syntra-backup create
# Not User=nobody: the tool reads /opt/syntra/shared/.env, which holds
# MASTER_KEY, and talks to the Docker socket.
User=root
# A backup that hangs on an unreachable database must not hold the timer
# open forever; the next run is a day away and will say the same thing.
TimeoutStartSec=30min
